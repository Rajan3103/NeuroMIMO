# ==============================================================================
# NeuroMIMO Environment Configuration Template
# ==============================================================================

# Server Network Configuration
NEUROMIMO_HOST=127.0.0.1
NEUROMIMO_PORT=8000
NEUROMIMO_DEBUG=false

# CORS Configuration (comma-separated origins)
NEUROMIMO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage & Checkpoint File Paths (relative to backend/ or absolute)
NEUROMIMO_DB_PATH=data/experiments.db
NEUROMIMO_CHECKPOINT_PATH=models/dnn_checkpoint.pt
NEUROMIMO_RESULTS_DIR=results

# Default Physical Layer Simulation Parameters
NEUROMIMO_DEFAULT_FFT_SIZE=64
NEUROMIMO_DEFAULT_CP_LENGTH=16
NEUROMIMO_DEFAULT_PILOT_SPACING=8
NEUROMIMO_DEFAULT_SNR_DB=20.0
NEUROMIMO_DEFAULT_MODULATION=QPSK
NEUROMIMO_DEFAULT_CHANNEL_MODEL=RAYLEIGH

# PyTorch Deep Learning Defaults
NEUROMIMO_TORCH_DEVICE=cpu
NEUROMIMO_DEFAULT_EPOCHS=20
NEUROMIMO_DEFAULT_BATCH_SIZE=64
NEUROMIMO_DEFAULT_LEARNING_RATE=0.001
NEUROMIMO_DEFAULT_TRAIN_SAMPLES=1000
NEUROMIMO_DEFAULT_SEED=42
